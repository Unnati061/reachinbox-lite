# Root .env — consumed by docker-compose.yml ONLY (Compose auto-loads this file).
# Application env vars live in backend/.env and frontend/.env.local.
#
# Copy to .env and fill in, then: npm run db:up
# Compose fails fast with a named variable if any of the three below are missing.

POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=
POSTGRES_DB=reachinbox_dev

# Host-side ports. Change these if something else already owns 5432 / 6379.
POSTGRES_PORT=5432
REDIS_PORT=6379
