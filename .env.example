# Root .env — consumed by docker-compose.yml ONLY, which is now an OPTIONAL
# local-Docker fallback. The DEFAULT setup uses hosted datastores (Neon +
# Upstash) configured in backend/.env and does not need this file at all.
# See DECISIONS.md "Phase 2.1 — mid-project pivot".
#
# You only need this if you run `npm run db:up` to host Postgres/Redis locally.
# Copy to .env and fill in, then: npm run db:up
# Compose fails fast with a named variable if any of the three below are missing.

POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=
POSTGRES_DB=reachinbox_dev

# Host-side ports. Change these if something else already owns 5432 / 6379.
POSTGRES_PORT=5432
REDIS_PORT=6379
