# ReachInbox-lite API — local environment.
# Copy to .env and fill in. `src/config/config.ts` validates every entry at
# startup and refuses to boot with a list of what is wrong.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Datastores --------------------------------------------------------------
# Must match the credentials/ports in the repo-root .env used by docker-compose.
DATABASE_URL=postgresql://reachinbox:REPLACE_WITH_ROOT_ENV_PASSWORD@localhost:5432/reachinbox_dev?schema=public
REDIS_URL=redis://localhost:6379

# --- Web -------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGIN=http://localhost:3000

# --- Email delivery ---------------------------------------------------------
# Optional today. These become required in the sending phase; until then the
# worker refuses to process jobs rather than pretending a send succeeded.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
