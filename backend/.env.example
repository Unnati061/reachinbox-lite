# ReachInbox-lite API — application environment.
# Copy to .env and fill in. `src/config/config.ts` validates every entry at
# startup and refuses to boot with a list of what is wrong.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Postgres (hosted: Neon) -------------------------------------------------
# Datastores are HOSTED, not local Docker — see DECISIONS.md "Phase 2.1".
# DATABASE_URL is the POOLED endpoint (host contains `-pooler`): what the app
# uses at runtime through the node-postgres driver adapter.
# DIRECT_URL is the UNPOOLED endpoint (same credentials, host WITHOUT `-pooler`):
# what Prisma Migrate uses, because the session-level advisory lock it takes does
# not survive PgBouncer transaction pooling. Wired in prisma.config.ts.
# On a non-pooled Postgres (e.g. local Docker) set DIRECT_URL equal to DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# --- Redis (hosted: Upstash) -------------------------------------------------
# rediss:// (double s) — Upstash requires TLS; ioredis negotiates it from the
# scheme. Upstash shows a `redis://` + `--tls` redis-cli form; for ioredis that
# is spelled `rediss://`.
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# --- Web ---------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGIN=http://localhost:3000

# --- Email delivery ----------------------------------------------------------
# Development uses Ethereal (nodemailer's throwaway SMTP): it accepts mail and
# shows it on a web preview page but never delivers to a real inbox. Generate a
# personal account (each is a real, persistent login) with:
#   node -e "require('nodemailer').createTestAccount().then(a=>console.log(a))"
# then copy its user/pass below. Preview inbox: https://ethereal.email.
# For production, point these at a real provider's SMTP instead.
# The worker requires SMTP_HOST and MAIL_FROM; without them dispatch jobs fail.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-user@ethereal.email
SMTP_PASSWORD=your-ethereal-password
# From address. MAIL_FROM is the envelope (bounce) address; the visible From is
# the registered sender's own address. In dev, set both to the Ethereal user.
MAIL_FROM=your-ethereal-user@ethereal.email

# --- Delivery controls -------------------------------------------------------
# Every worker sharing this Redis queue honours these values. Set 0 for no
# global interval (the per-sender hourly cap still applies).
WORKER_CONCURRENCY=5
MIN_SEND_INTERVAL_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# --- Search ------------------------------------------------------------------
# Optional Elasticsearch-compatible endpoint (Elastic Cloud, self-hosted, etc.).
# This is a rebuildable search projection; Postgres remains the source of truth.
ELASTICSEARCH_URL=https://your-elasticsearch-endpoint:9243

# --- Slack rate-limit notifications -----------------------------------------
# Register SLACK_REDIRECT_URI exactly in Slack's OAuth Redirect URLs. The app
# requests incoming-webhook + chat:write; Slack chooses the notification channel.
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:4000/api/integrations/slack/callback
